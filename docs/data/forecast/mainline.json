5,0.3295,0.3296,0.3297,0.3297,0.3298,0.3298,0.3298,0.3299,0.3299,0.3299,0.3299,0.3299,0.3299,0.3299,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33,0.33]},"onsets":{"T3":2034.0,"K1":2033.2,"D2":2033.0,"E3":2028.5,"G2":2036.0},"kind":"medoid","n":2000,"agree":0.2961,"p":9.202413413471752e-07,"argmax":{"wl":{"T":"T2","K":"K1","A":"A2","C":"C1","R":"R4","D":"D2","S":"S1","P":"P3","E":"E3","L":"L4","G":"G4"},"p":7.4377713877975e-06},"layers":{"economy":[{"year":2030,"text":"Stalled build-out: stranded capex, cheap second-hand compute, innovation continuing on efficiency rather than scale.","cites":["concepts/ai-bubble-debate"]},{"year":2045,"text":"Whatever the 2020s broke or built, mid-century output is dominated by AI-run production; the argument is allocation.","cites":["sources/ai-2040-plan-a"]}],"labor":[{"year":2030,"text":"Split labor market: augmented professions pull ahead, exposed ones hollow; geography and sector decide who feels which future.","cites":["concepts/ai-displacement-vs-augmentation"]},{"year":2050,"text":"Work as identity loosens: dividend schemes, contribution economies, and the post-work constitution debates.","cites":["concepts/ai-labor-disruption"]}],"law":[{"year":2030,"text":"Patchwork doctrine: state laws multiply, preemption contested, copyright settled into licensing, liability migrating from disclosure to outcomes.","cites":["analysis/ai-copyright-litigation","analysis/eu-vs-us-ai-regulation"]},{"year":2045,"text":"Personhood at the bar: digital minds, AI counsel, and liability for autonomous systems define the mid-century docket.","cites":["sources/ai-2040-plan-a"]}],"geopolitics":[{"year":2030,"text":"The race entrenches: compute blocs, chip chokepoints, Taiwan premium; every summit is about AI even when it isn't.","cites":["analysis/us-china-ai-competition"]},{"year":2050,"text":"Power follows compute and its energy; the map of capability is the map of leverage.","cites":["concepts/compute-governance"]}],"public":[{"year":2030,"text":"Fracture: pro- and anti-AI identities cut across parties; the Europe-2031 pattern of publics splitting within countries.","cites":["sources/europe-2031"]},{"year":2050,"text":"A generation raised with minds-on-tap; the meaning politics the far field keeps on the table.","cites":["sources/machines-of-loving-grace"]}],"science":[{"year":2060,"text":"The frontier is nonhuman: discovery outpaces comprehension, and translation becomes its own discipline.","cites":["sources/ai-2040-plan-a"]}],"climate":[{"year":2030,"text":"Constraint as climate policy: scarce compute keeps AI load flat while efficiency work compounds.","cites":["concepts/compute-governance"]},{"year":2060,"text":"Climate outcomes track governance more than compute: the decisive variable was always deployment speed of what the science found.","cites":["industries/energy"]}]}}